    config MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx
        bool "ELE S1xx/S4xx"
        # Enabled by default on SoCs that have ELE S1xx/S4xx, but only when an
        # Mbed TLS flavor is in use. Other consumers can still select this HW
        # driver explicitly.
        default y if (MCUX_COMPONENT_middleware.mbedtls.tf_psa_crypto || \
                      MCUX_COMPONENT_middleware.mbedtls3x) && \
                     (MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx.soc_s100 || \
                      MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx.soc_s400)


        select MCUX_COMPONENT_component.psa_crypto_driver
        select MCUX_COMPONENT_driver.s3mu
        select MCUX_COMPONENT_component.ele_crypto
        select MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx_rng
        select MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx_opaque
        select MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx_transparent
        # Default EdgeLock firmware container per SoC (imply = overridable default,
        # so the user can still change or unselect the FW).
        imply MCUX_COMPONENT_component.edgelock.s100.rt2660a0_ele_container if MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx.soc_s100
        imply MCUX_COMPONENT_component.edgelock.s400.mxrt1180b0alt_ahab_container if MCUX_COMPONENT_component.psa_crypto_driver.ele_s1xx_4xx.soc_s400

