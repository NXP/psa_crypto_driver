# PSA crypto drivers extends the TF-PSA-Crypto (Mbed TLS 4.x / tf-psa-crypto)
# as well as the legacy MbedTLS 3.x.

    config MCUX_COMPONENT_component.psa_crypto_driver
        bool
        # Default on when an Mbed TLS flavor (TF-PSA-Crypto / Mbed TLS 4.x or
        # legacy Mbed TLS 3.x) is used. Other consumers (TF-M, wireless
        # framework, direct users) can still select the driver / sub-components
        # explicitly without relying on this default.
        default y if MCUX_COMPONENT_middleware.mbedtls.tf_psa_crypto || MCUX_COMPONENT_middleware.mbedtls3x
        help
            Toplevel PSA Crypto Driver component symbol.
            Auto-selected by platform-specific configurations.


