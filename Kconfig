    config MCUX_COMPONENT_component.psa_crypto_driver.els_pkc
        bool "ELS PKC"
        select MCUX_COMPONENT_component.psa_crypto_driver
        select MCUX_COMPONENT_component.psa_crypto_driver.els_pkc.oracle
        select MCUX_COMPONENT_component.psa_crypto_driver.els_pkc.common
        select MCUX_COMPONENT_component.psa_crypto_driver.els_pkc.transparent
        select MCUX_COMPONENT_component.psa_crypto_driver.els_pkc.opaque
        select MCUX_COMPONENT_component.els_pkc.psa_driver

        if MCUX_COMPONENT_component.psa_crypto_driver.els_pkc
          choice
            prompt "Hardware Platform Selection"
            default MCUX_DEPENDENCY_COMPONENT_component.psa_crypto_driver.els_pkc_DEPEND_ANYOF_1_OPTION_1
            config MCUX_DEPENDENCY_COMPONENT_component.psa_crypto_driver.els_pkc_DEPEND_ANYOF_1_OPTION_1
                bool "RW61x with TRNG support"
                select MCUX_COMPONENT_driver.trng
                select MCUX_COMPONENT_component.psa_crypto_driver.use_trng_compile_option
                depends on MCUX_HW_DEVICE_RW610 || MCUX_HW_DEVICE_RW612

            config MCUX_DEPENDENCY_COMPONENT_component.psa_crypto_driver.els_pkc_DEPEND_ANYOF_1_OPTION_2
                bool "MCXN/RT700/LPC55S36 series devices"
                depends on MCUX_HW_DEVICE_MCXN546 || MCUX_HW_DEVICE_MCXN547 || MCUX_HW_DEVICE_MCXN946 || MCUX_HW_DEVICE_MCXN947 || MCUX_HW_DEVICE_MCXN235 || MCUX_HW_DEVICE_MCXN236 || MCUX_HW_DEVICE_MCXN247 || MCUX_HW_DEVICE_MCXN526 || MCUX_HW_DEVICE_MCXN527 || MCUX_HW_DEVICE_MCXN536 || MCUX_HW_DEVICE_MCXN537 || MCUX_HW_DEVICE_MCXN556S || MCUX_HW_DEVICE_MCXN557S || MCUX_HW_DEVICE_MCXN556T || MCUX_HW_DEVICE_MCXN557T || MCUX_HW_DEVICE_MCXN246T || MCUX_HW_DEVICE_MCXN247T || MCUX_HW_DEVICE_MCXN527T || MCUX_HW_DEVICE_MCXN536T || MCUX_HW_DEVICE_MCXN537T || MCUX_HW_DEVICE_MCXN546T || MCUX_HW_DEVICE_MCXN547T || MCUX_HW_DEVICE_MCXN946T || MCUX_HW_DEVICE_MCXN947T || MCUX_HW_DEVICE_MIMXRT798S || MCUX_HW_DEVICE_MIMXRT758S || MCUX_HW_DEVICE_MIMXRT735S || MCUX_HW_DEVICE_LPC55S36

          endchoice
        endif

