menu "PSA Crypto Driver"

    config MCUX_COMPONENT_component.psa_crypto_driver
        bool
        default n
        help
            Toplevel PSA Crypto Driver component symbol.
            Auto-selected by platform-specific configurations.

    config MCUX_COMPONENT_component.psa_crypto_driver.osal
        bool
        default y if MCUX_COMPONENT_component.psa_crypto_driver

    if MCUX_COMPONENT_component.psa_crypto_driver.osal
        choice MCUX_COMPONENT_component.psa_crypto_driver.osal.selection
            prompt "OSAL Selection"
            default MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.frtos if MCUX_COMPONENT_middleware.freertos-kernel
            default MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.baremetal

            config MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.baremetal
                bool "Baremetal"
                help
                    Empty baremetal OSAL implementation for PSA Crypto Driver.
                    Must be implemented by the user.

            config MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.frtos
                bool "FreeRTOS"
                depends on MCUX_COMPONENT_middleware.freertos-kernel
                help
                    FreeRTOS OSAL for PSA Crypto Driver.
        endchoice
    endif

    config MCUX_COMPONENT_component.psa_crypto_driver.osal.baremetal
        depends on MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.baremetal
        bool
        default y
        help
            Kept as a separate config to allow for backward compatibility, but now should only be selected
            via the MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.baremetal choice.

    config MCUX_COMPONENT_component.psa_crypto_driver.osal.frtos
        depends on MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.frtos
        bool
        default y
        help
            Kept as a separate config to allow for backward compatibility, but now should only be selected
            via the MCUX_COMPONENT_component.psa_crypto_driver.osal.selection.frtos choice.

    config MCUX_COMPONENT_component.psa_crypto_driver.mbedtls_thread_alt
        bool "Mbed TLS Thread Alt"

    config MCUX_COMPONENT_component.psa_crypto_driver.els_pkc.oracle.rw61x
