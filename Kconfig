    config MCUX_COMPONENT_component.psa_crypto_driver.sgi.common
        bool "SGI Common"

    config MCUX_COMPONENT_component.psa_crypto_driver.sgi.transparent
        bool "SGI Transparent"

    config MCUX_COMPONENT_component.psa_crypto_driver.sgi.feature.double_cipher_enable
        bool "SGI Double cipher enable"
        default false
        help
            Enable double encryption/decryption with CMAC verification.
            When enabled, cipher operations are performed twice and verified
            using AES-128-CMAC to detect potential faults.
			
    config MCUX_COMPONENT_component.psa_crypto_driver.sgi
        bool "SGI"
        select MCUX_COMPONENT_component.psa_crypto_driver
        select MCUX_COMPONENT_component.psa_crypto_driver.sgi.transparent
        select MCUX_COMPONENT_component.psa_crypto_driver.sgi.common
        select MCUX_COMPONENT_component.sgi_pkc
        select MCUX_COMPONENT_component.sgi_pkc.example

        select MCUX_COMPONENT_component.psa_crypto_driver.use_trng_compile_option

    config MCUX_COMPONENT_component.psa_crypto_driver.pkc
        bool "SGI PKC"
        select MCUX_COMPONENT_component.sgi_pkc.pkc
        select MCUX_COMPONENT_component.sgi_pkc.ecc
        select MCUX_COMPONENT_component.sgi_pkc.signature
        select MCUX_COMPONENT_component.sgi_pkc.rsa

        # We provide option to have SGI-only, or SGI+PKC, but PKC-only is not available.
        select MCUX_COMPONENT_component.psa_crypto_driver.sgi

    config USING_TF_PSA_CRYPTO
        bool
        default y if MCUX_COMPONENT_middleware.mbedtls.tf_psa_crypto
        help
            This config option is set to 'y' when TF PSA Crypto is selected
            as the caller of PSA Crypto Driver.

    config USING_MBEDTLS_3X
        bool
        default y if MCUX_COMPONENT_middleware.mbedtls3x
        help
            This config option is set to 'y' when Mbed TLS 3.x is selected
            as the caller of PSA Crypto Driver.

