    config MCUX_COMPONENT_component.psa_crypto_driver.ele_s200.feature.hash_context_persistence
        bool "ELE S200 Hash Context Persistence"
        depends on MCUX_HW_SOC_SERIES_KW47 || MCUX_HW_SOC_SERIES_MCXW72
        default false
        help
            Enables multipart hash context persistence across sleep/wake cycles
            when the ELE S200 subsystem loses internal contexts, but the application
            RAM does not.
            Supported only on KW47 and MCXW72 series.

    config MCUX_COMPONENT_component.psa_crypto_driver.ele_s200
        bool "ELE S200"
        select MCUX_COMPONENT_component.psa_crypto_driver
        select MCUX_COMPONENT_component.psa_crypto_driver.ele_s200.common
        select MCUX_COMPONENT_component.psa_crypto_driver.ele_s200.transparent
        select MCUX_COMPONENT_component.psa_crypto_driver.ele_s200.opaque
        select MCUX_COMPONENT_middleware.secure-subsystem

        imply MCUX_COMPONENT_component.psa_crypto_driver.util.wrapcheck_static_inline

    config MCUX_COMPONENT_component.psa_crypto_driver.casper
        bool "CASPER"
        select MCUX_COMPONENT_component.psa_crypto_driver
        select MCUX_COMPONENT_driver.casper

        # We provide option to have hashcrypt-only, or CASPER+hashcrypt, but CASPER-only is not available.
        select MCUX_COMPONENT_component.psa_crypto_driver.hashcrypt

